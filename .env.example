NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://restaurant:change-me@localhost:5432/restaurant
DB_CONNECT_TIMEOUT_MS=2000
# Comma-separated exact HTTP(S) origins, or * alone to reflect all Origins for CORS.
# WARNING: wildcard CORS does not bypass cookie refresh/logout trusted-Origin checks.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# REQUIRED. Generate a cryptographically random secret with at least 32 bytes.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_ACCESS_SECRET=

# HTTPS origins permitted as product image references. Empty means images cannot be attached.
# Media uploads, transformation, verified ownership and signed URLs require separate object-storage integration.
MEDIA_ALLOWED_ORIGINS=

# Required for issuing, reprinting and rotating table QR codes.
# Use 32 cryptographically random bytes encoded as 64 hex characters, never commit it.
# On Dokploy, set a persistent secret and preserve it across redeploys; losing it breaks QR reprinting.
QR_TOKEN_ENCRYPTION_KEY=
# HTTPS origin of the public customer Vite app, e.g. https://menu.example.com (without path).
CUSTOMER_APP_ORIGIN=

# v1.9 — secure Expo device storage; required for POST /employee/devices and for worker.
# Use a distinct persistent 32-byte key (64 hex). Never reuse QR encryption key.
PUSH_TOKEN_ENCRYPTION_KEY=
# true only on a separate Dokploy worker process, false on API replicas.
PUSH_DISPATCH_ENABLED=false
# Optional Expo Enhanced Push Security token. Keep secret.
EXPO_PUSH_ACCESS_TOKEN=

# v1.11 managed photos + private documents. Configure all five fields or none.
# MEDIA_PUBLIC_ORIGIN is an HTTPS CDN serving S3 images at /r/<tenant>/<media-id>.webp.
# Do not make the entire bucket public; restrict public access to image keys only.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_ORIGIN=
RESTAURANT_BASE_DOMAIN=abdulrahman-hares.com